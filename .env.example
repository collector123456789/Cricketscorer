# Create a local .env file next to app.py and set these values.
# If MONGODB_URI is omitted, app.py will reuse the Mongo host and username from
# .idea/dataSources*.xml and only require MONGODB_PASSWORD here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=crick
MONGODB_PASSWORD=<password-if-using-pycharm-datasource>
MONGODB_DB=cricket_scorer
MONGODB_TIMEOUT_MS=10000
# Optional: override the CA bundle used for Atlas TLS.
# MONGODB_TLS_CA_FILE=C:\path\to\cacert.pem
# Optional: debugging only. Do not enable in production.
# MONGODB_TLS_ALLOW_INVALID_CERTS=false
